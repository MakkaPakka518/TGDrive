[Unit]
Description=Telegram Channel Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgdrive
Group=tgdrive
WorkingDirectory=/opt/tgdrive/backend
EnvironmentFile=/opt/tgdrive/backend/.env
ExecStart=/opt/tgdrive/backend/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 3219
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
